{
  "name": "spectre",
  "version": "1.1.6",
  "description": "SPECTRE — Pelco-D pan/tilt pedestal controller (local web console + Electron overlay).",
  "main": "server/dist/src/index.js",
  "author": "bassit-ali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassit-ali/Spectre.git"
  },
  "bugs": {
    "url": "https://github.com/bassit-ali/Spectre/issues"
  },
  "homepage": "https://github.com/bassit-ali/Spectre#readme",
  "keywords": [
    "spectre",
    "pelco-d",
    "pan-tilt",
    "rs-485",
    "serial",
    "electron",
    "fastify"
  ],
  "scripts": {
    "build": "npm run web:build && npm run server:build",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node server/dist/src/index.js",
    "dev:server": "tsx watch server/src/index.ts",
    "pip:start": "npm --prefix pip-shell start",
    "rebuild:serial": "npm rebuild serialport",
    "probe": "node scripts/probe-com.mjs",
    "test:regression": "node scripts/regression-full.mjs && node scripts/regression-ux.mjs",
    "test:ux": "node scripts/regression-ux.mjs",
    "test:transport": "npm run server:build && node scripts/transport-parity.mjs",
    "presets:sectors": "node scripts/set-sector-presets.mjs",
    "pack:docs": "powershell -ExecutionPolicy Bypass -File ./installers/common/build-install-guide.ps1",
    "pack:win": "powershell -ExecutionPolicy Bypass -File ./installers/windows/build.ps1 && npm run pack:docs",
    "pack:linux": "powershell -ExecutionPolicy Bypass -File ./installers/linux/package.ps1 && npm run pack:docs",
    "spectre:uninstall": "powershell -ExecutionPolicy Bypass -File ./installers/windows/uninstall-system.ps1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "serialport": "^12.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
