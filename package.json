{
  "name": "pelco-pt",
  "version": "1.1.0",
  "description": "SPECTRE — Pelco-D pan/tilt pedestal controller (local web console + Electron overlay).",
  "main": "server/dist/src/index.js",
  "author": "bassit-ali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassit-ali/Spectre.git"
  },
  "bugs": {
    "url": "https://github.com/bassit-ali/Spectre/issues"
  },
  "homepage": "https://github.com/bassit-ali/Spectre#readme",
  "keywords": [
    "spectre",
    "pelco-d",
    "pan-tilt",
    "rs-485",
    "serial",
    "electron",
    "fastify"
  ],

  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-builder install-app-deps",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win zip",
    "pack:linux": "npm run build && electron-builder --linux tar.gz",
    "probe": "node scripts/probe-com.mjs",
    "test:regression": "node scripts/regression-full.mjs && node scripts/regression-ux.mjs",
    "test:ux": "node scripts/regression-ux.mjs",
    "presets:sectors": "node scripts/set-sector-presets.mjs",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node server/dist/src/index.js",
    "dev:server": "tsx watch server/src/index.ts",
    "spectre:uninstall": "powershell -ExecutionPolicy Bypass -File ./installers/windows/uninstall-system.ps1",
    "pip:start": "npm --prefix pip-shell start"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "electron-store": "^8.2.0",
    "fastify": "^5.12.8",
    "serialport": "^12.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.pelcopt.controller",
    "productName": "PelcoPT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "pelco-pt-win-x64.${ext}"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Utility",
      "artifactName": "pelco-pt-linux-x64.${ext}"
    }
  }
}
